<template>
  <div class="list-container">
    <div class="base_query_input">
    <el-form :model="queryParams" ref="queryForm" size="small" :inline="true" label-width="128px">
#foreach($column in $columns)
#if($column.query)
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.htmlType == "input")
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-input
          v-model="queryParams.${column.javaField}"
          placeholder="请输入${comment}"
          clearable
          @keyup.enter.native="handleSearch"
        />
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && "" != $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-select v-model="queryParams.${column.javaField}" placeholder="请选择${comment}" clearable>
          <el-option
            v-for="dict in #[[$]]#dict.getDictData('${dictType}')"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="date"
          value-format="yyyy-MM-dd"
          placeholder="请选择${comment}">
        </el-date-picker>
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
      <el-form-item label="${comment}">
        <el-date-picker
          v-model="daterange${AttrName}"
          style="width: 240px"
          value-format="yyyy-MM-dd"
          type="daterange"
          range-separator="-"
          start-placeholder="开始日期"
          end-placeholder="结束日期"
        ></el-date-picker>
      </el-form-item>
#end
#end
#end
        <div class="filter_btn">
          <el-button @click="handleSearch" icon="el-icon-search" size="small">查询</el-button>
          <el-button @click="handleReset" icon="el-icon-reset" size="small">重置</el-button>
        </div>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button
          type="primary"
          plain
          icon="el-icon-plus"
          size="mini"
          @click="handleCreate"
        >新增</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="danger"
          icon="el-icon-delete"
          size="mini"
          @click="handleRemove"
        >删除</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          plain
          icon="el-icon-download"
          size="mini"
          @click="handleExport"
        >导出</el-button>
      </el-col>
    </el-row>
    
    <div class="joyin-filter-result">
      <AbsTable class="crm-w100" ref="absTable" v-bind="tableParams" height="100%" :searchParams="queryParams">
        <template #action_default="{ row, rowIndex }">
          <div class="action flex-evenly">
            <el-button type="text" icon="el-icon-edit" @click.stop="edit(row, rowIndex)">修改</el-button>
            <el-button type="text" icon="el-icon-view" @click.stop="view(row, rowIndex)">查看</el-button>
            <el-button type="text" icon="el-icon-delete" @click="remove(row)">删除</el-button>
          </div>
        </template>
      </AbsTable>
    </div>
  </div>
  </div>
</template>

<script>
import AbsTable from '@/components/AbsTable'
import { tableParams } from './data'
import {delete${ClassName}ById,exportList} from "./api";

export default {
  name: "${ClassName}",
  components: {
    AbsTable
  },
  data() {
    return {
      tableParams:tableParams,
      queryParams:{},
      showSettingRole:false
    };
  },
  created() {
  },
  methods: {
    /**
     * 查询
     */
     handleSearch() {
      this.#[[$]]#refs.absTable.refresh(true)
    },
    /**
     * 重置
     */
    handleReset() {
      this.queryParams = { }
    },
    /**
     * 新增
     */
    handleCreate() {
      this.functions.OLink(this, '/${moduleName}/${ClassName}/Add',null,'','新增')
    },
    /**
     * 编辑
     * @param row
     */
    edit(row){
      this.functions.OLink(this, '/${moduleName}/${ClassName}/Edit/'+ row.${pkColumn.javaField},null,'','编辑')
    },
    /**
     * 查看用户
     * @param row
     */
    view(row){
      this.functions.OLink(this, '/${moduleName}/${ClassName}/View/'+ row.${pkColumn.javaField},null,'','查看')
    },
    /**
     * 删除用户
     * @param row
     */
    remove(row) {
      this.#[[$]]#confirm('确定删除当前数据?', {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'info'
      }).then(() => {
        delete${ClassName}ById({id:row.${pkColumn.javaField}}).then(response => {
          this.#[[$]]#notify({
            title: '成功',
            message: '删除成功',
            type: 'success',
            duration: 2000,
            position: 'bottom-right'
          })
          this.handleSearch()
        })
      })
    },
    handleRemove(){
      let rows = this.#[[$]]#refs.absTable.getCheckboxRecords()
      if(rows.length == 0){
        this.#[[$]]#message.warning('请选择要删除的数据')
        return
      }
      this.#[[$]]#confirm('确定删除当前数据?', {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'info'
      }).then(() => {
        const param={
          ${pkColumn.javaField}:rows.map(item=>item.${pkColumn.javaField}).join(',')
        }
        delete${ClassName}ById(param).then(response => {
          this.#[[$]]#notify({
            title: '成功',
            message: '删除成功',
            type: 'success',
            duration: 2000,
            position: 'bottom-right'
          })
          this.handleSearch()
        })
      })
    },
    handleExport(){
      exportList(this.queryParams)
    }
  }
};
</script>
